            "events": {
              "dom": {
                "onClick": {
                  "config": {
                    "script": "\n\timport system\n\n\t# Go up from Button → button → root\n\troot \u003d self.parent.parent\n\n\ttry:\n\t\t# Read dropdown values\n\t\tsub_area \u003d root.getChild(\"FlexContainer\").getChild(\"sub_area\").props.value\n\t\tfault \u003d root.getChild(\"FlexContainer_1\").getChild(\"fault\").props.value\n\n\t\t# Write to database\n\t\tquery \u003d \"\"\"\n\t\t\tUPDATE downtime_formply_press\n\t\t\tSET sub_area \u003d ?, fault \u003d ?\n\t\t\tWHERE start_time \u003d (SELECT max(start_time) FROM downtime_formply_press)\n\t\t\"\"\"\n\t\targs \u003d [sub_area, fault]\n\t\tsystem.db.runPrepUpdate(query, args, \"downtime_data\")\n\n\t\t# Reset dropdowns\n\t\troot.getChild(\"FlexContainer\").getChild(\"sub_area\").props.value \u003d None\n\t\troot.getChild(\"FlexContainer_1\").getChild(\"fault\").props.value \u003d None\n\n\t\t# Close the popup\n\t\tsystem.perspective.closePopup(\"Ruf91Bp1\")\n\n\t\t# Log confirmation (for troubleshooting)\n\t\tsystem.util.getLogger(\"DowntimeFormplyPress\").info(\"Downtime record updated successfully.\")\n\n\texcept Exception as e:\n\t\tsystem.util.getLogger(\"DowntimeFormplyPress\").error(\"Error updating downtime record: %s\" % str(e))"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
